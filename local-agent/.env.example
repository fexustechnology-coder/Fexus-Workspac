# Copy this file to .env and fill in real values.

# The port this agent listens on — localhost only, never exposed to the network.
LOCAL_AGENT_PORT=9911

# Copy this EXACT value from FEXUS's Local PC Agent settings page
# (Owner Dashboard → Local PC Agent → Setup).
LOCAL_AGENT_PAIRING_TOKEN=

# Comma-separated list of directories this agent is allowed to touch.
# Options: desktop, documents, downloads, fexusWorkspace
# Must ALSO be enabled on the FEXUS side (Local PC Agent settings) —
# both checks are required, not either/or.
LOCAL_AGENT_ALLOWED_DIRS=desktop
